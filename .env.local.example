# ==============================================================================
# FounderSync Environment Variables Template
# ==============================================================================

# 1. Supabase Connection (Backend PostgreSQL)
# Required for persisting metrics, strategic analyses, reality checks, decisions, and heatmap scores.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SERVER-ONLY: Service Role Key
# WARNING: NEVER expose this key to the browser or prefix with NEXT_PUBLIC_.
# Used solely in lib/supabase-server.ts for administrative or server route persistence.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Dual-AI Model IDs (Configurable Model Identifiers)
# Gemini Strategic Analyst Model (default: gemini-3.1-flash-lite, or gemini-3.1-pro-preview / gemini-3.5-flash)
GEMINI_MODEL=gemini-3.1-flash-lite

# Grok Contradictory Advisor Model (default: grok-4.5, or grok-4-fast for high-throughput)
GROK_MODEL=grok-4.5

# ------------------------------------------------------------------------------
# NOTE ON RUNTIME API KEYS (GEMINI & GROK):
# Following Industry 5.0 security and human-centric privacy principles:
# Gemini and Grok API keys are NOT stored in the database or server environment.
# They are optionally provided at runtime in the UI by the founder, held in memory,
# sent only to their respective Next.js API routes (/api/strategic-analysis and /api/reality-check),
# and never persisted beyond the immediate request lifecycle.
# If keys are omitted or invalid, both modules automatically fall back to deterministic mock generators.
# ------------------------------------------------------------------------------
